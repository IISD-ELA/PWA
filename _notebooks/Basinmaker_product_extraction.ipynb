    "\n",
    "# Read WSC outlet point metadata\n",
    "wsc_dp = pd.read_csv(\"c:\\\\Users\\\\emilito\\\\Documents\\\\PWA\\\\Data\\\\Raw\\\\manning\\\\WSC_data\\\\station_metadata_historical.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert csv to geodataframe\n",
    "wsc_dp_gdf = gpd.GeoDataFrame(\n",
