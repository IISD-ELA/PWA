  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read BasinMaker shapefile\n",
    "basins_gdf = gpd.read_file(DATA_RAW + \"Basinmaker_RoutingProduct/drainage_region_0004_00015_v2-1/finalcat_info_v2-1.shp\")\n",
    "\n",
    "# Read WSC outlet point metadata\n",
    "wsc_dp = pd.read_csv(DATA_RAW + \"WSC_data/station_metadata_historical.csv\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 210,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read BasinMaker shapefile\n",
