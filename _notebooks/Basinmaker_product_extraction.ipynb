   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Select Manning Cannal Subbasins"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[4076245, 4076244]\n"
     ]
    }
   ],
   "source": [
    "# Create list containing inital Manning Canal subbasins and its upstream subbasin\n",
    "for i, row in basins_gdf.iterrows():\n",
    "    if row['DowSubId'] == dp:\n",
    "        sub_select = [row['DowSubId'], row['SubId']]\n",
    "\n",
    "print(sub_select)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[4076245, 4076244, 4076298, 4075410, 4076349, 4076348, 4076546, 4076565, 4075680, 4075849, 4075841, 4074754, 4076027, 4076058, 4075203, 4075219, 4076596, 4076041, 4076439, 4076610, 4076611, 4075700, 4075707]\n"
     ]
    }
   ],
   "source": [
    "# Add subbasins to Manning Canal list if they are connected to previously added subbasins (via DowSubId field)\n",
    "n = 0\n",
    "while n == 0:\n",
    "    for i, row in basins_gdf.iterrows():\n",
    "        if row['DowSubId'] in sub_select and row['SubId'] not in sub_select:\n",
    "            sub_select.append(row['SubId'])\n",
    "            break\n",
    "    else:\n",
    "        n = 1\n",
    "print(sub_select)"
   ]
  },
